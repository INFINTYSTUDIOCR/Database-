{
  "negations": {
    "rules": [
      {
        "left": "do not",
        "right": "don't",
        "note": "(no)"
      },
      {
        "left": "does not",
        "right": "doesn't",
        "note": "(no — para He / She / It)"
      }
    ],
    "examples": [
      {
        "left": "I don't go",
        "right": "Yo no voy",
        "note": ""
      },
      {
        "left": "He doesn't work",
        "right": "Él no trabaja",
        "note": ""
      },
      {
        "left": "She doesn't know",
        "right": "Ella no sabe",
        "note": ""
      }
    ],
    "pattern": "¿Notás el patrón? Cuando usás DON'T o DOESN'T — el verbo vuelve a su forma original.",
    "transforms": [
      {
        "left": "He goes",
        "right": "He doesn't go",
        "tip": "no \"goes\" — vuelve a \"go\""
      },
      {
        "left": "She has",
        "right": "She doesn't have",
        "tip": "no \"has\" — vuelve a \"have\""
      }
    ],
    "takeaway": "El verbo principal siempre vuelve al infinitivo cuando hay negación."
  },
  "present": {
    "rules": [
      {
        "left": "I / you / we / they",
        "right": "verbo base",
        "note": "(hábito)"
      },
      {
        "left": "he / she / it",
        "right": "verbo + s",
        "note": "(3ª persona)"
      }
    ],
    "examples": [
      {
        "left": "I go home every day",
        "right": "Yo voy a casa todos los días",
        "note": ""
      },
      {
        "left": "She works in San José",
        "right": "Ella trabaja en San José",
        "note": ""
      },
      {
        "left": "They study English",
        "right": "Ellos estudian inglés",
        "note": ""
      }
    ],
    "pattern": "¿Ves? He/She/It lleva la -s en el verbo. El resto usa la forma base.",
    "transforms": [
      {
        "left": "I work",
        "right": "She works",
        "tip": "3ª persona → +s"
      },
      {
        "left": "They go",
        "right": "He goes",
        "tip": "go → goes"
      }
    ],
    "takeaway": "Presente simple = hábito o hecho. Solo he/she/it suma -s."
  },
  "past": {
    "rules": [
      {
        "left": "verbo regular",
        "right": "verbo + ed",
        "note": "(worked)"
      },
      {
        "left": "verbo irregular",
        "right": "forma 2",
        "note": "(went / saw / made)"
      }
    ],
    "examples": [
      {
        "left": "She worked yesterday",
        "right": "Ella trabajó ayer",
        "note": ""
      },
      {
        "left": "I went home",
        "right": "Yo me fui a casa",
        "note": ""
      },
      {
        "left": "They saw the movie",
        "right": "Ellos vieron la película",
        "note": ""
      }
    ],
    "pattern": "Pasado = acción terminada. No hace falta auxiliar en afirmativa.",
    "transforms": [
      {
        "left": "I work",
        "right": "I worked",
        "tip": "regular → -ed"
      },
      {
        "left": "I go",
        "right": "I went",
        "tip": "irregular → forma 2"
      }
    ],
    "takeaway": "En pasado afirmativo: solo cambiás el verbo. En negativa: did + not + base."
  },
  "progressive": {
    "rules": [
      {
        "left": "español",
        "right": "ESTAR + ando/endo",
        "note": ""
      },
      {
        "left": "inglés",
        "right": "TO BE + VERBO+ING",
        "note": "(am / is / are)"
      }
    ],
    "examples": [
      {
        "left": "I am studying English now",
        "right": "Estoy estudiando inglés ahora",
        "note": ""
      },
      {
        "left": "She is cooking dinner",
        "right": "Ella está cocinando la cena",
        "note": ""
      },
      {
        "left": "They are playing soccer",
        "right": "Ellos están jugando fútbol",
        "note": ""
      }
    ],
    "pattern": "Sin TO BE no hay progresivo. ING = ando/endo.",
    "transforms": [
      {
        "left": "I study",
        "right": "I am studying",
        "tip": "añadís am/is/are + ING"
      },
      {
        "left": "She cooks",
        "right": "She is cooking",
        "tip": "cook → cooking"
      }
    ],
    "takeaway": "Progresivo = TO BE + verbo + í ene ge (ando/endo)."
  },
  "perfect": {
    "rules": [
      {
        "left": "have · has · had",
        "right": "jaf · jas · jad",
        "note": "(decí con pausa)"
      },
      {
        "left": "I / you / we / they",
        "right": "have + participio",
        "note": "(he…)"
      },
      {
        "left": "he / she / it",
        "right": "has + participio",
        "note": "(ha…)"
      },
      {
        "left": "todos",
        "right": "had + participio",
        "note": "(había… = pasado perfecto)"
      }
    ],
    "examples": [
      {
        "left": "have · has · had",
        "right": "jaf · jas · jad",
        "note": ""
      },
      {
        "left": "I have finished",
        "right": "Yo he terminado",
        "note": ""
      },
      {
        "left": "She has seen it",
        "right": "Ella lo ha visto",
        "note": ""
      },
      {
        "left": "I had finished",
        "right": "Yo había terminado",
        "note": ""
      },
      {
        "left": "They had gone",
        "right": "Ellos habían ido",
        "note": ""
      }
    ],
    "pattern": "Primero el paradigm: jaf. jas. jad. Luego: have/has + participio = presente perfecto. Had + participio = pasado perfecto (había).",
    "transforms": [
      {
        "left": "have / has",
        "right": "he / ha + participio",
        "tip": "presente perfecto"
      },
      {
        "left": "had",
        "right": "había + participio",
        "tip": "pasado perfecto"
      },
      {
        "left": "I finished yesterday",
        "right": "I had finished before…",
        "tip": "pasado simple ≠ pasado perfecto"
      }
    ],
    "takeaway": "Siempre empezá por jaf. jas. jad. Presente perfecto = have/has + participio. Pasado perfecto = had + participio."
  },
  "have_had": {
    "rules": [
      {
        "left": "have",
        "right": "jaf",
        "note": "I / you / we / they"
      },
      {
        "left": "has",
        "right": "jas",
        "note": "he / she / it"
      },
      {
        "left": "had",
        "right": "jad",
        "note": "pasado / pasado perfecto"
      }
    ],
    "examples": [
      {
        "left": "have · has · had",
        "right": "jaf · jas · jad",
        "note": ""
      },
      {
        "left": "I have finished",
        "right": "Yo he terminado",
        "note": ""
      },
      {
        "left": "She has finished",
        "right": "Ella ha terminado",
        "note": ""
      },
      {
        "left": "I had finished",
        "right": "Yo había terminado",
        "note": ""
      }
    ],
    "pattern": "Decí con pausa en voz CR: jaf. jas. jad. — nunca \"ave\".",
    "transforms": [
      {
        "left": "have",
        "right": "has",
        "tip": "3ª persona → jas"
      },
      {
        "left": "have / has",
        "right": "had",
        "tip": "pasado / había → jad"
      }
    ],
    "takeaway": "jaf. jas. jad. — tres formas. Had = pasado perfecto auxiliar."
  },
  "future": {
    "rules": [
      {
        "left": "will + verbo",
        "right": "-ré / -rá",
        "note": "(decisión / futuro)"
      },
      {
        "left": "going to + verbo",
        "right": "voy a…",
        "note": "(plan)"
      }
    ],
    "examples": [
      {
        "left": "I will call you tomorrow",
        "right": "Te llamaré mañana",
        "note": ""
      },
      {
        "left": "I am going to study",
        "right": "Voy a estudiar",
        "note": ""
      },
      {
        "left": "They are going to travel",
        "right": "Ellos van a viajar",
        "note": ""
      }
    ],
    "pattern": "Will = decisión o predicción. Going to = plan ya pensado.",
    "transforms": [
      {
        "left": "I call",
        "right": "I will call",
        "tip": "will + base"
      },
      {
        "left": "I study",
        "right": "I am going to study",
        "tip": "be + going to + base"
      }
    ],
    "takeaway": "Futuro: will + base, o am/is/are + going to + base."
  },
  "future_perfect": {
    "rules": [
      {
        "left": "will + have + participio",
        "right": "habré / habrá…",
        "note": "(futuro perfecto)"
      },
      {
        "left": "by Friday / by then",
        "right": "antes de ese punto",
        "note": "(marca de tiempo)"
      }
    ],
    "examples": [
      {
        "left": "I will have finished",
        "right": "Yo habré terminado",
        "note": ""
      },
      {
        "left": "She will have left by 5",
        "right": "Ella habrá salido para las 5",
        "note": ""
      },
      {
        "left": "They will have done it",
        "right": "Ellos lo habrán hecho",
        "note": ""
      },
      {
        "left": "We will have arrived",
        "right": "Habremos llegado",
        "note": ""
      }
    ],
    "pattern": "Will + have + participio = acción terminada ANTES de un momento futuro. No es should have.",
    "transforms": [
      {
        "left": "I finish",
        "right": "I will have finished",
        "tip": "will + have + V3"
      },
      {
        "left": "I will finish",
        "right": "I will have finished",
        "tip": "futuro simple ≠ futuro perfecto"
      }
    ],
    "takeaway": "Futuro perfecto = will + have + participio (habré terminado). Pediste esto → esto se enseña YA."
  },
