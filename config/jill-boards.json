  "there": {
    "rules": [
      {
        "left": "There is",
        "right": "hay (1)",
        "note": ""
      },
      {
        "left": "There are",
        "right": "hay (2+)",
        "note": ""
      },
      {
        "left": "have / has",
        "right": "posesión",
        "note": "(tengo / tiene)"
      }
    ],
    "examples": [
      {
        "left": "There is a book on the table",
        "right": "Hay un libro en la mesa",
        "note": ""
      },
      {
        "left": "There are two chairs",
        "right": "Hay dos sillas",
        "note": ""
      },
      {
        "left": "I have a book",
        "right": "Yo tengo un libro",
        "note": ""
      }
    ],
    "pattern": "There is/are = existencia (HAY). Have/has = posesión (TENGO).",
    "transforms": [
      {
        "left": "I have a car",
        "right": "There is a car",
        "tip": "posesión vs existencia"
      },
      {
        "left": "She has two dogs",
        "right": "There are two dogs",
        "tip": "has ≠ there are"
      }
    ],
    "takeaway": "No mezcles HAY (there) con TENGO (have)."
  },
