    {
      "id": "M001",
      "order": 1,
      "title": "Pronombres — los 5 tipos",
      "canonTrackIds": ["pronouns"],
      "say": "CANON: config/canon/module-01-pronombres.txt (íntegro). Hoy instalamos en inglés lo que ya saben en español: cinco tipos — sujeto, objeto, posesivo adjetivo, posesivo pronominal, reflexivo. Misma lógica. Diferente forma. Rapid Fire + identificación de tipo.",
      "bridge": "5 tipos ES↔EN: sujeto hace · objeto recibe · pos.adj acompaña · pos.pron reemplaza · reflexivo vuelve al sujeto.",
      "checklist": [
        "5 tipos nombrados",
        "You singular/plural por contexto",
        "His = adj y pronominal",
        "She/Her/Her/Hers/Herself progresión",
        "Identificación de tipo en frase",
        "Rapid Fire <2s"
      ],
      "mini": { "questions": 8, "timerSec": 25, "passPct": 80 },
      "kaboomBank": [
        { "q": "Ella — sujeto →", "options": ["She", "Her", "Hers", "Herself"], "answer": 0, "explain": "Sujeto = She." },
        { "q": "Ella — objeto →", "options": ["Her", "She", "Hers", "Herself"], "answer": 0, "explain": "Objeto = Her." },
        { "q": "Ella — posesivo adjetivo →", "options": ["Her", "Hers", "She", "Herself"], "answer": 0, "explain": "Pos.Adj acompaña: Her phone." },
        { "q": "Ella — posesivo pronominal →", "options": ["Hers", "Her", "She", "Herself"], "answer": 0, "explain": "Pos.Pron reemplaza: The bag is hers." },
        { "q": "Ella — reflexivo →", "options": ["Herself", "Her", "Hers", "She"], "answer": 0, "explain": "Reflexivo = Herself." },
        { "q": "Él — objeto →", "options": ["Him", "He", "His", "Himself"], "answer": 0, "explain": "Objeto = Him." },
        { "q": "Él — posesivo pronominal →", "options": ["His", "Him", "He", "Himself"], "answer": 0, "explain": "His no cambia entre adj y pronominal." },
        { "q": "Nosotros — objeto →", "options": ["Us", "We", "Our", "Ours"], "answer": 0, "explain": "Objeto = Us." },
        { "q": "Nosotros — reflexivo →", "options": ["Ourselves", "Us", "Our", "Ours"], "answer": 0, "explain": "Reflexivo plural = Ourselves." },
        { "q": "I called her. — tipo de her →", "options": ["Objeto", "Sujeto", "Pos.Adj", "Reflexivo"], "answer": 0, "explain": "her recibe la acción = objeto." },
        { "q": "That bag is hers. — tipo →", "options": ["Posesivo pronominal", "Posesivo adjetivo", "Objeto", "Sujeto"], "answer": 0, "explain": "hers reemplaza = pronominal." },
        { "q": "Her phone is here. — tipo de Her →", "options": ["Posesivo adjetivo", "Posesivo pronominal", "Objeto", "Sujeto"], "answer": 0, "explain": "Her acompaña a phone = adj." },
        { "q": "He hurt himself. — tipo →", "options": ["Reflexivo", "Objeto", "Sujeto", "Pos.Adj"], "answer": 0, "explain": "Acción vuelve al sujeto." },
