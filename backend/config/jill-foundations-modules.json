        { "q": "He makes dinner → negación", "options": ["He doesn't make dinner", "He don't make dinner", "He doesn't makes dinner", "He not makes dinner"], "answer": 0, "explain": "doesn't + make." },
        { "q": "They see the problem →", "options": ["They don't see the problem", "They doesn't see", "They don't sees", "They no see"], "answer": 0, "explain": "don't + see." },
        { "q": "She does it alone →", "options": ["She doesn't do it alone", "She don't do it", "She doesn't does it", "She not do it"], "answer": 0, "explain": "doesn't + do." },
        { "q": "¿He/She/It? → auxiliar de negación", "options": ["doesn't", "don't", "isn't", "aren't"], "answer": 0, "explain": "3ª → doesn't." }
