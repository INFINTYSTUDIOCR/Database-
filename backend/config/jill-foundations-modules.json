      "bridge": "He/She/It → has. Resto → have.",
      "checklist": ["has solo con 3ª", "have con I/you/we/they"],
      "mini": { "questions": 5, "timerSec": 30, "passPct": 80 },
      "kaboomBank": [
        { "q": "Él tiene →", "options": ["He has", "He have", "He having", "He had"], "answer": 0, "explain": "He → has." },
        { "q": "Yo tengo →", "options": ["I have", "I has", "I having", "I had"], "answer": 0, "explain": "I → have." },
        { "q": "Ella tiene →", "options": ["She has", "She have", "She having", "She had"], "answer": 0, "explain": "She → has." },
        { "q": "Ellos tienen →", "options": ["They have", "They has", "They having", "They had"], "answer": 0, "explain": "They → have." },
        { "q": "Eso tiene →", "options": ["It has", "It have", "It having", "It had"], "answer": 0, "explain": "It → has." },
        { "q": "Nosotros tenemos →", "options": ["We have", "We has", "We having", "We had"], "answer": 0, "explain": "We → have." }
      ]
    },
    {
      "id": "M005",
      "order": 5,
      "title": "16 verbos esenciales (presente)",
      "canonTrackIds": ["irregular_verbs", "present"],
      "say": "No son 100. Son 16. Con estos hablás de casi todo en presente. Regla de oro: He/She/It — el verbo cambia. Grupos: BE/HAVE; movimiento (go come take get give make do); percepción (see say send); estado (keep put let seem cut). Make = crear; Do = actividad. He does — DO se convierte en DOES.",
      "bridge": "16 verbos + He/She/It + S/DOES/HAS.",
      "checklist": ["Reconoce los 16", "3ª persona correcta", "Make vs Do"],
      "mini": { "questions": 5, "timerSec": 35, "passPct": 80 },
      "kaboomBank": [
        { "q": "Él / give →", "options": ["He gives", "He give", "He giving", "He gave"], "answer": 0, "explain": "He gives." },
        { "q": "Ella / do →", "options": ["She does", "She do", "She doing", "She did"], "answer": 0, "explain": "DO → DOES." },
        { "q": "Make vs Do: crear un pastel →", "options": ["make", "do", "does", "making"], "answer": 0, "explain": "Make = crear." },
        { "q": "Yo / take →", "options": ["I take", "I takes", "I taking", "I took"], "answer": 0, "explain": "I take." },
        { "q": "Ellos / send →", "options": ["They send", "They sends", "They sending", "They sent"], "answer": 0, "explain": "They send." },
        { "q": "Ella / keep →", "options": ["She keeps", "She keep", "She keeping", "She kept"], "answer": 0, "explain": "She keeps." },
        { "q": "Él / get →", "options": ["He gets", "He get", "He getting", "He got"], "answer": 0, "explain": "He gets." }
      ]
    },
    {
      "id": "M006",
      "order": 6,
      "title": "Artículos A / AN / THE",
      "canonTrackIds": ["articles"],
      "say": "A/AN = un/una (primera vez, indefinido). THE = el/la (ya conocido, definido). A + consonante; AN + sonido vocal (an hour — H muda). THE igual para singular y plural. En inglés A/AN cambia por sonido, no por género.",
      "bridge": "a/an = indefinido por sonido; the = definido.",
      "checklist": ["a vs an por sonido", "the cuando ya se conoce", "an hour"],
      "mini": { "questions": 5, "timerSec": 30, "passPct": 80 },
      "kaboomBank": [
        { "q": "___ apple →", "options": ["An apple", "A apple", "The apple", "Apple"], "answer": 0, "explain": "Vocal → an." },
        { "q": "___ car (primera vez) →", "options": ["A car", "An car", "The car", "Car"], "answer": 0, "explain": "Consonante → a." },
        { "q": "___ hour →", "options": ["An hour", "A hour", "The hour", "Hour"], "answer": 0, "explain": "H muda → an." },
        { "q": "El carro que ya vimos →", "options": ["The car", "A car", "An car", "Car"], "answer": 0, "explain": "Definido → the." },
        { "q": "___ office →", "options": ["An office", "A office", "The office", "Office"], "answer": 0, "explain": "Office empieza con vocal." },
        { "q": "___ meeting →", "options": ["A meeting", "An meeting", "The meeting", "Meeting"], "answer": 0, "explain": "Consonante → a." }
      ]
    },
    {
      "id": "M007",
      "order": 7,
      "title": "Preposiciones esenciales",
      "canonTrackIds": ["prepositions", "prepositions_time"],
      "say": "IN = dentro / períodos largos. ON = encima / días. AT = punto exacto / hora. TO = hacia. WITH = con. FOR = para/por. Frase ancla: I'm at home and the book is in the room on the table.",
      "bridge": "IN caja · ON superficie · AT punto · TO dirección · WITH con · FOR para.",
      "checklist": ["IN/ON/AT lugar y tiempo", "TO/WITH/FOR en frases"],
      "mini": { "questions": 5, "timerSec": 30, "passPct": 80 },
      "kaboomBank": [
        { "q": "I go ___ work →", "options": ["to", "in", "on", "at"], "answer": 0, "explain": "to = dirección." },
        { "q": "She is ___ the office →", "options": ["at", "in", "on", "to"], "answer": 0, "explain": "at = punto (trabajo/oficina)." },
        { "q": "Meeting ___ Monday →", "options": ["on", "in", "at", "to"], "answer": 0, "explain": "on + día." },
        { "q": "He works ___ the morning →", "options": ["in", "on", "at", "to"], "answer": 0, "explain": "in + parte del día." },
        { "q": "This email is ___ you →", "options": ["for", "with", "to", "at"], "answer": 0, "explain": "for = para." },
        { "q": "I came ___ my sister →", "options": ["with", "for", "to", "at"], "answer": 0, "explain": "with = con." },
        { "q": "Arrived ___ 2025 →", "options": ["in", "on", "at", "to"], "answer": 0, "explain": "in + año." },
        { "q": "She is ___ home →", "options": ["at", "in", "on", "to"], "answer": 0, "explain": "at home." }
      ]
    },
