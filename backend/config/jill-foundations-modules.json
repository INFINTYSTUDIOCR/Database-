        { "q": "Ellos — posesivo adjetivo →", "options": ["Their", "Theirs", "Them", "Themselves"], "answer": 0, "explain": "Their house." },
        { "q": "Este proyecto es nuestro →", "options": ["This project is ours", "This project is our", "This project is us", "This project is ourselves"], "answer": 0, "explain": "Pronominal = ours." }
      ]
    },
    {
      "id": "M002",
      "order": 2,
      "title": "Presente: He/She/It + S",
      "canonTrackIds": ["present"],
      "say": "Los pronombres son piezas de Lego: solos no sirven — necesitan verbo. Regla de oro del presente: cuando es He, She o It — el verbo cambia. Nadie más. I go / You go / He goes / She goes / It goes / We go / They go. En español conjugamos todo; en inglés solo He/She/It lleva S.",
      "bridge": "He/She/It → verbo + S. Todos los demás → forma base.",
      "checklist": ["Identifica He/She/It", "Agrega S solo a 3ª persona", "I/You/We/They sin S"],
      "mini": { "questions": 5, "timerSec": 30, "passPct": 80 },
      "kaboomBank": [
        { "q": "Ella / go →", "options": ["She goes", "She go", "She going", "She gone"], "answer": 0, "explain": "She = He/She/It → goes." },
        { "q": "Yo / go →", "options": ["I go", "I goes", "I going", "I gone"], "answer": 0, "explain": "I → forma base." },
        { "q": "Él / make →", "options": ["He makes", "He make", "He making", "He made"], "answer": 0, "explain": "He → makes." },
        { "q": "Ellos / see →", "options": ["They see", "They sees", "They seeing", "They saw"], "answer": 0, "explain": "They → see." },
        { "q": "Eso / seem →", "options": ["It seems", "It seem", "It seeming", "It seemed"], "answer": 0, "explain": "It → seems." },
        { "q": "Nosotros / come →", "options": ["We come", "We comes", "We coming", "We came"], "answer": 0, "explain": "We → come." },
        { "q": "¿He/She/It? She / do →", "options": ["She does", "She do", "She doing", "She did"], "answer": 0, "explain": "DO → DOES con She." }
      ]
    },
    {
      "id": "M003",
      "order": 3,
      "title": "BE — am / is / are",
      "canonTrackIds": ["present"],
      "say": "BE es el verbo más usado. Cambia tres veces: AM — ARE — IS. I am, You are, He/She/It is, We are, They are. Misma lógica que soy/sos/es/somos/son — otra forma.",
      "bridge": "I→am · You/We/They→are · He/She/It→is.",
      "checklist": ["am/is/are correctos", "No mezcla I is / He are"],
      "mini": { "questions": 5, "timerSec": 30, "passPct": 80 },
      "kaboomBank": [
        { "q": "Yo soy / estoy →", "options": ["I am", "I is", "I are", "I be"], "answer": 0, "explain": "I am." },
        { "q": "Ella es →", "options": ["She is", "She are", "She am", "She be"], "answer": 0, "explain": "She is." },
        { "q": "Nosotros estamos →", "options": ["We are", "We is", "We am", "We be"], "answer": 0, "explain": "We are." },
        { "q": "Ellos son →", "options": ["They are", "They is", "They am", "They be"], "answer": 0, "explain": "They are." },
        { "q": "Eso está →", "options": ["It is", "It are", "It am", "It be"], "answer": 0, "explain": "It is." },
        { "q": "Vos sos →", "options": ["You are", "You is", "You am", "You be"], "answer": 0, "explain": "You are." }
      ]
    },
    {
