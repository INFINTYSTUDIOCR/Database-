        "left": "preposición",
        "right": "siempre + VERBO-ING",
        "note": "in/at/of/about/for"
      }
    ],
    "examples": [
      {
        "left": "I am working",
        "right": "TO BE + ING — continuo"
      },
      {
        "left": "They were eating",
        "right": "TO BE en pasado + ING"
      },
      {
        "left": "She has been studying",
        "right": "BEEN también abre ING"
      },
      {
        "left": "live → living / run → running",
        "right": "E muda / duplica consonante"
      }
    ],
    "pattern": "Clase 009: TO BE es la llave; ING es la puerta.",
    "transforms": [
      {
        "left": "I walking",
        "right": "I am walking",
        "tip": "falta TO BE"
      },
      {
        "left": "She working",
        "right": "She is working",
        "tip": "TO BE obligatorio"
      }
    ],
    "takeaway": "TO BE=llave · ING=puerta · TO=flecha · ING=concepto · prep siempre ING."
  },
