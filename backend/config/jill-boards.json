{
  "negations": {
    "rules": [
      {
        "left": "do not",
        "right": "don't",
        "note": "(no)"
      },
      {
        "left": "does not",
        "right": "doesn't",
        "note": "(no — para He / She / It)"
      }
    ],
    "examples": [
      {
        "left": "I don't go",
        "right": "Yo no voy",
        "note": ""
      },
      {
        "left": "He doesn't work",
        "right": "Él no trabaja",
        "note": ""
      },
      {
        "left": "She doesn't know",
        "right": "Ella no sabe",
        "note": ""
      }
    ],
    "pattern": "¿Notás el patrón? Cuando usás DON'T o DOESN'T — el verbo vuelve a su forma original.",
    "transforms": [
      {
        "left": "He goes",
        "right": "He doesn't go",
        "tip": "no \"goes\" — vuelve a \"go\""
      },
      {
        "left": "She has",
        "right": "She doesn't have",
        "tip": "no \"has\" — vuelve a \"have\""
      }
    ],
    "takeaway": "El verbo principal siempre vuelve al infinitivo cuando hay negación."
  },
  "present": {
    "rules": [
      { "left": "TO + verbo", "right": "señal de infinitivo", "note": "desaparece al conjugar" },
      { "left": "I / you / we / they", "right": "verbo base", "note": "sin cambio" },
      { "left": "he / she / it", "right": "verbo + S", "note": "regla de oro" },
      { "left": "go / do", "right": "goes / does", "note": "termina en O → ES" },
      { "left": "have", "right": "has", "note": "cambia completo" },
      { "left": "be", "right": "am / is / are", "note": "único con 3 formas" }
    ],
    "examples": [
      { "left": "To go → I go", "right": "TO se fue al conjugar" },
      { "left": "She goes", "right": "She + O → ES" },
      { "left": "He does", "right": "He + O → ES" },
      { "left": "It has", "right": "Have → Has" },
      { "left": "She sees me", "right": "verbo + objeto (M1)" },
      { "left": "He keeps his car", "right": "verbo + pos.adj (M1)" },
      { "left": "She sees herself", "right": "verbo + reflexivo (M1)" }
    ],
    "pattern": "He, She, It — agrega S. Go y Do — agrega ES. Have — cambia a Has. Be — am/is/are. Los módulos se conectan.",
    "transforms": [
      { "left": "She / go", "right": "She goes", "tip": "O → ES" },
      { "left": "He / do", "right": "He does", "tip": "O → ES" },
      { "left": "It / have", "right": "It has", "tip": "Have → Has" },
      { "left": "They / go", "right": "They go", "tip": "They no cambia" },
      { "left": "She / make", "right": "She makes", "tip": "+ S" }
    ],
    "takeaway": "16 verbos + He/She/It. Antes de conjugar: ¿Es He, She o It?"
  },
  "past": {
    "rules": [
      { "left": "En pasado", "right": "nadie cambia el verbo", "note": "alivio vs presente" },
      { "left": "I / He / She / It", "right": "WAS", "note": "BE excepción" },
      { "left": "You / We / They", "right": "WERE", "note": "BE excepción" },
      { "left": "put / cut / let", "right": "iguales PR=PS", "note": "ancla dice el tiempo" },
      { "left": "Ancla", "right": "yesterday / last / ago", "note": "ubica la historia" }
    ],
    "examples": [
      { "left": "She goes → She went", "right": "En pasado She no agrega S" },
      { "left": "He has → He had", "right": "has desaparece; had para todos" },
      { "left": "They was → They were", "right": "They → WERE" },
      { "left": "I put … yesterday", "right": "put igual + ancla = pasado" },
      { "left": "She sent me her report yesterday", "right": "M1+M2+M3 juntos" },
      { "left": "Goed / sended / maked", "right": "NO existen — irregulares" }
    ],
    "pattern": "En presente He/She/It cambia. En pasado nadie cambia. Excepción BE: was/were. put/cut/let + ancla.",
    "transforms": [
      { "left": "Go", "right": "Went", "tip": "Rapid Fire" },
      { "left": "She goes", "right": "She went", "tip": "presente→pasado" },
      { "left": "They + be", "right": "They were", "tip": "WERE" },
      { "left": "I + be", "right": "I was", "tip": "WAS" },
      { "left": "She / put / yesterday", "right": "She put … yesterday", "tip": "ancla" }
    ],
    "takeaway": "Pasado = todos iguales. WAS/WERE. Ancla con put/cut/let. Integra M1+M2."
  },
  "progressive": {
    "rules": [
      { "left": "TO BE", "right": "llave del ING continuo", "note": "am/is/are/was/were/been" },
      { "left": "ING", "right": "puerta: ando / endo", "note": "acción continua" },
      { "left": "TO + verbo", "right": "flecha: intención", "note": "want/need/plan + TO" },
      { "left": "preposición", "right": "siempre + VERBO-ING", "note": "in/at/of/about/for" }
    ],
    "examples": [
      { "left": "I am working", "right": "TO BE + ING — continuo" },
      { "left": "They were eating", "right": "TO BE en pasado + ING" },
      { "left": "She has been studying", "right": "BEEN también abre ING" },
      { "left": "live → living / run → running", "right": "E muda / duplica consonante" }
    ],
    "pattern": "Clase 009: TO BE es la llave; ING es la puerta.",
    "transforms": [
      { "left": "I walking", "right": "I am walking", "tip": "falta TO BE" },
      { "left": "She working", "right": "She is working", "tip": "TO BE obligatorio" }
    ],
    "takeaway": "TO BE=llave · ING=puerta · TO=flecha · ING=concepto · prep siempre ING."
  },
  "perfect": {
    "rules": [
      { "left": "Español", "right": "HABER + participio", "note": "he / ha / había" },
      { "left": "HAVE / HAS + PP", "right": "afecta el presente", "note": "I/You/We/They · He/She/It" },
      { "left": "HAD + PP", "right": "antes de otro pasado", "note": "HAD para todos" },
      { "left": "HAVE/HAS/HAD + BEEN + ING", "right": "empezó y sigue", "note": "BEEN activa ING" },
      { "left": "Sin HAVE/HAS", "right": "no hay perfecto", "note": "I gone = mal" }
    ],
    "examples": [
      { "left": "I have gone", "right": "yo he ido — sin cuándo exacto" },
      { "left": "She has seen it", "right": "HAS porque She" },
      { "left": "When I arrived she had left", "right": "HAD = primero en el tiempo" },
      { "left": "I have been working", "right": "BEEN + ING = sigue ahora" },
      { "left": "I went yesterday", "right": "pasado simple = ancla" },
      { "left": "She has sent me her report", "right": "M1+M4 juntos" }
    ],
    "pattern": "¿Sigue? → BEEN+ING. ¿Antes de otro pasado? → HAD+PP. ¿Afecta ahora sin cuándo? → HAVE/HAS+PP. ¿Sé cuándo? → pasado simple.",
    "transforms": [
      { "left": "Go", "right": "Gone", "tip": "participio" },
      { "left": "She / see", "right": "She has seen", "tip": "HAS" },
      { "left": "They / go (antes)", "right": "They had gone", "tip": "HAD" },
      { "left": "I / have / work", "right": "I have been working", "tip": "BEEN+ING" },
      { "left": "I went yesterday", "right": "pasado simple", "tip": "ancla" }
    ],
    "takeaway": "Cuatro LEGO: HAVE+PP · HAD+PP · HAVE+BEEN+ING · HAD+BEEN+ING. Español primero."
  },
